# Armonia: kiosk'taki uyap_app'in tarayici acma istegi (tek satir URL). Her baglanti icin bir
# armonia-tarayici@.service ornegi baslar. Yalniz kiosk kullanicisi yazabilir. Claude, 2026-11-14.
[Unit]
Description=Armonia tarayici istek soketi

[Socket]
ListenStream=/run/armonia-tarayici.sock
SocketUser=kiosk
SocketGroup=kiosk
SocketMode=0600
Accept=yes
# Ard arda tiklamada servis firtinasi olmasin
MaxConnections=4
MaxConnectionsPerSource=2
# Tetik siniri asilinca soket kalici "failed" olmasin diye genis pencere (guvenlik-denetci D3)
TriggerLimitIntervalSec=10s
TriggerLimitBurst=20

[Install]
WantedBy=sockets.target
